# Copy to .env before running `docker compose up`.
# Every value below has a working development default in docker-compose.yml,
# so an empty .env still boots. Override what you need.

# ── Ports ─────────────────────────────────────────────────────────────
# The ONLY published port. Everything else is internal-network only.
FRONTEND_PORT=8080

# ── Database ──────────────────────────────────────────────────────────
# Postgres runs in Docker. Nothing to install locally.
#
# Two roles, and the split is load-bearing:
#   POSTGRES_PASSWORD  owns the schema and runs migrations. It is a SUPERUSER,
#                      and superusers BYPASS row-level security even when RLS is
#                      FORCEd. It must never be used by the running application.
#   APP_DB_PASSWORD    smartplate_app — a plain LOGIN role that RLS actually
#                      applies to. main-service and the worker use only this one.
#
# Local-only limitation (D12): the smartplate_app password is set by migration
# 0002_app_role.sql, which cannot read env vars. Changing APP_DB_PASSWORD here
# requires an `ALTER ROLE smartplate_app PASSWORD ...` as well.
POSTGRES_PASSWORD=smartplate_dev
APP_DB_PASSWORD=smartplate_app_dev

# ── Secrets ───────────────────────────────────────────────────────────
# Change both before any non-local deployment.
JWT_SECRET=dev-jwt-secret-change-me
SERVICE_TOKEN=dev-service-token

# ── AI (agent-service) ────────────────────────────────────────────────
# Not required until P6. The service starts and reports healthy without it.
GEMINI_API_KEY=
# VERIFY THIS BEFORE BUILDING AGAINST IT — Gemini model ids change often.
# See docs/architecture/smartplate-agent-service-contracts-and-prompts.md (U16).
GEMINI_MODEL=gemini-2.5-flash
