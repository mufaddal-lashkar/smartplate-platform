{
	"name": "smartplate-platform",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/bot-service",
		"apps/frontend",
		"apps/main-service",
		"packages/*",
		"db"
	],
	"scripts": {
		"up": "docker compose up --build",
		"dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
		"down": "docker compose down",
		"reset": "docker compose down -v",
		"logs": "docker compose logs -f",
		"lint": "biome check .",
		"lint:ci": "biome ci .",
		"format": "biome check --write .",
		"type:check": "bun run --cwd apps/frontend type:check && bun run --cwd apps/bot-service type:check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"seed": "docker compose exec -T main-service sh -c \"cd /app && bun run db/seed/index.ts\"",
		"test": "docker compose exec -T main-service sh -c \"cd /app && bun test apps/main-service/tests\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"drizzle-kit": "0.31.10"
	}
}
