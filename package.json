{
	"name": "smartplate-platform",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/web",
		"apps/main-service",
		"packages/*"
	],
	"scripts": {
		"up": "docker compose up --build",
		"dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
		"down": "docker compose down",
		"reset": "docker compose down -v",
		"logs": "docker compose logs -f",
		"lint": "biome check .",
		"lint:ci": "biome ci .",
		"format": "biome check --write .",
		"type:check": "bun run --cwd apps/web type:check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6"
	}
}
